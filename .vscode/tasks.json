{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "sim-git-status",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoLogo",
				"-Command",
				"cd f:\\git\\halow-demo; git status --short; git --no-pager log --oneline -6"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "sim-diff-stat",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoLogo",
				"-Command",
				"cd f:\\git\\halow-demo; git --no-pager diff --stat; echo '--- untracked sizes ---'; git status --short | Select-String '^\\?\\?'"
			],
			"problemMatcher": [],
			"group": "build"
		},
